{
  "$defs": {
    "Animation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "mode": {
          "default": "none",
          "enum": [
            "none",
            "fade",
            "pop",
            "slide-up"
          ],
          "title": "Mode",
          "type": "string"
        },
        "entrance_seconds": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Entrance Seconds",
          "type": "number"
        },
        "exit_seconds": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Exit Seconds",
          "type": "number"
        },
        "initial_scale": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0.5,
          "title": "Initial Scale",
          "type": "number"
        },
        "displacement": {
          "default": 0.08,
          "maximum": 0.25,
          "minimum": 0,
          "title": "Displacement",
          "type": "number"
        }
      },
      "title": "Animation",
      "type": "object"
    },
    "AutomaticBinding": {
      "additionalProperties": false,
      "properties": {
        "timeline": {
          "$ref": "#/$defs/Timeline"
        },
        "audio": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "timeline",
        "audio"
      ],
      "title": "AutomaticBinding",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "default",
          "enum": [
            "default",
            "custom",
            "builtin"
          ],
          "title": "Kind",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "enum": [
                "amiri-regular",
                "amiri-bold",
                "anton-regular"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "font_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Id"
        },
        "sha256": {
          "default": "7da195a74c55bef988d0d48f9508bd5d849425c1770dba5d7bfc6ce9ed848954",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "family": {
          "default": "DejaVu Sans",
          "maxLength": 128,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "style": {
          "default": "Book",
          "maxLength": 128,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        }
      },
      "title": "Binding",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "exclusiveMaximum": 120,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "End",
          "type": "number"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "Cue",
      "type": "object"
    },
    "ReferenceBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/color_analysis__Source"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "operation_id"
      ],
      "title": "ReferenceBinding",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "original",
          "enum": [
            "original",
            "reference",
            "mix",
            "mute"
          ],
          "title": "Mode",
          "type": "string"
        },
        "original_volume": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Original Volume",
          "type": "number"
        },
        "reference_volume": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Reference Volume",
          "type": "number"
        },
        "reference_offset_seconds": {
          "default": 0,
          "maximum": 120,
          "minimum": 0,
          "title": "Reference Offset Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "Style": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "default": "white",
          "pattern": "^(white|yellow|#[0-9a-fA-F]{6})$",
          "title": "Color",
          "type": "string"
        },
        "size": {
          "default": "medium",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "title": "Size",
          "type": "string"
        },
        "placement": {
          "default": "bottom-center",
          "enum": [
            "bottom-center",
            "center"
          ],
          "title": "Placement",
          "type": "string"
        },
        "font": {
          "default": "default",
          "enum": [
            "default",
            "custom",
            "amiri-regular",
            "amiri-bold",
            "anton-regular"
          ],
          "title": "Font",
          "type": "string"
        },
        "font_origin": {
          "default": "manual",
          "enum": [
            "manual",
            "assisted"
          ],
          "title": "Font Origin",
          "type": "string"
        },
        "size_percent": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Percent"
        },
        "outline_color": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_percent": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline Percent"
        },
        "shadow_color": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Shadow Color",
          "type": "string"
        },
        "shadow_percent": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Shadow Percent",
          "type": "number"
        },
        "alignment": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Alignment",
          "type": "string"
        },
        "horizontal": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizontal"
        },
        "vertical": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertical"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "italic": {
          "default": false,
          "title": "Italic",
          "type": "boolean"
        }
      },
      "title": "Style",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "whole",
            "cuts"
          ],
          "title": "Mode",
          "type": "string"
        },
        "footage": {
          "$ref": "#/$defs/footage_analysis__Source"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Duration Seconds",
          "type": "number"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        }
      },
      "required": [
        "mode",
        "footage",
        "duration_seconds"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "color_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "pattern": "^[0-9]+$",
          "title": "Video Id",
          "type": "string"
        },
        "canonical_url": {
          "pattern": "^https://www\\.tiktok\\.com/@[A-Za-z0-9._-]+/video/[0-9]+$",
          "title": "Canonical Url",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "canonical_url",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    },
    "footage_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "clip_id": {
          "pattern": "^clip-[0-9a-f]{32}\\.(mp4|mov)$",
          "title": "Clip Id",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "clip_id",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "cues": {
      "items": {
        "$ref": "#/$defs/Cue"
      },
      "maxItems": 200,
      "title": "Cues",
      "type": "array"
    },
    "style": {
      "$ref": "#/$defs/Style"
    },
    "animation": {
      "$ref": "#/$defs/Animation"
    },
    "provenance": {
      "default": "manual",
      "enum": [
        "manual",
        "srt_import",
        "automatic_transcription"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "automatic_proposal_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Automatic Proposal Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "timeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timeline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "automatic_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutomaticBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "font_binding": {
      "$ref": "#/$defs/Binding"
    }
  },
  "title": "Track",
  "type": "object"
}
