{
  "$defs": {
    "AutomaticBinding": {
      "additionalProperties": false,
      "properties": {
        "timeline": {
          "$ref": "#/$defs/Timeline"
        },
        "audio": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "timeline",
        "audio"
      ],
      "title": "AutomaticBinding",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "exclusiveMaximum": 120,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "End",
          "type": "number"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "Cue",
      "type": "object"
    },
    "ReferenceBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/color_analysis__Source"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "operation_id"
      ],
      "title": "ReferenceBinding",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "original",
          "enum": [
            "original",
            "reference",
            "mix",
            "mute"
          ],
          "title": "Mode",
          "type": "string"
        },
        "original_volume": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Original Volume",
          "type": "number"
        },
        "reference_volume": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Reference Volume",
          "type": "number"
        },
        "reference_offset_seconds": {
          "default": 0,
          "maximum": 120,
          "minimum": 0,
          "title": "Reference Offset Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "whole",
            "cuts"
          ],
          "title": "Mode",
          "type": "string"
        },
        "footage": {
          "$ref": "#/$defs/footage_analysis__Source"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Duration Seconds",
          "type": "number"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        }
      },
      "required": [
        "mode",
        "footage",
        "duration_seconds"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "color_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "pattern": "^[0-9]+$",
          "title": "Video Id",
          "type": "string"
        },
        "canonical_url": {
          "pattern": "^https://www\\.tiktok\\.com/@[A-Za-z0-9._-]+/video/[0-9]+$",
          "title": "Canonical Url",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "canonical_url",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    },
    "footage_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "clip_id": {
          "pattern": "^clip-[0-9a-f]{32}\\.(mp4|mov)$",
          "title": "Clip Id",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "clip_id",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "algorithm_version": {
      "const": "base-word-cues-v1",
      "default": "base-word-cues-v1",
      "title": "Algorithm Version",
      "type": "string"
    },
    "model_repository": {
      "const": "Systran/faster-whisper-base",
      "default": "Systran/faster-whisper-base",
      "title": "Model Repository",
      "type": "string"
    },
    "model_revision": {
      "const": "ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66",
      "default": "ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66",
      "title": "Model Revision",
      "type": "string"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "requested_language": {
      "enum": [
        "auto",
        "en",
        "ar"
      ],
      "title": "Requested Language",
      "type": "string"
    },
    "detected_language": {
      "maxLength": 10,
      "minLength": 1,
      "title": "Detected Language",
      "type": "string"
    },
    "output_id": {
      "format": "uuid",
      "title": "Output Id",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/AutomaticBinding"
    },
    "cues": {
      "items": {
        "$ref": "#/$defs/Cue"
      },
      "maxItems": 200,
      "title": "Cues",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "versions",
    "requested_language",
    "detected_language",
    "output_id",
    "output_sha256",
    "binding",
    "cues",
    "generated_at"
  ],
  "title": "Proposal",
  "type": "object"
}
