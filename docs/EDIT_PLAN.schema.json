{
  "$defs": {
    "ReferenceBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/color_analysis__Source"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "analyzed_at": {
          "format": "date-time",
          "title": "Analyzed At",
          "type": "string"
        }
      },
      "required": [
        "source",
        "operation_id",
        "schema_version",
        "algorithm_version",
        "analyzed_at"
      ],
      "title": "ReferenceBinding",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "source_start_frame": {
          "maximum": 3600,
          "minimum": 0,
          "title": "Source Start Frame",
          "type": "integer"
        },
        "source_end_frame": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Source End Frame",
          "type": "integer"
        },
        "output_start_frame": {
          "maximum": 3600,
          "minimum": 0,
          "title": "Output Start Frame",
          "type": "integer"
        },
        "output_end_frame": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Output End Frame",
          "type": "integer"
        }
      },
      "required": [
        "source_start_frame",
        "source_end_frame",
        "output_start_frame",
        "output_end_frame"
      ],
      "title": "Segment",
      "type": "object"
    },
    "color_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "pattern": "^[0-9]+$",
          "title": "Video Id",
          "type": "string"
        },
        "canonical_url": {
          "pattern": "^https://www\\.tiktok\\.com/@[A-Za-z0-9._-]+/video/[0-9]+$",
          "title": "Canonical Url",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "canonical_url",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    },
    "footage_analysis__Source": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "clip_id": {
          "pattern": "^clip-[0-9a-f]{32}\\.(mp4|mov)$",
          "title": "Clip Id",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "clip_id",
        "media_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generation_algorithm_version": {
      "default": "reference-timing-grid-v1",
      "title": "Generation Algorithm Version",
      "type": "string"
    },
    "fps": {
      "const": 30,
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "pacing": {
      "$ref": "#/$defs/ReferenceBinding"
    },
    "footage": {
      "$ref": "#/$defs/footage_analysis__Source"
    },
    "footage_frames": {
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Footage Frames",
      "type": "integer"
    },
    "requested_duration_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 120,
      "title": "Requested Duration Seconds",
      "type": "number"
    },
    "output_frames": {
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Output Frames",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "suggested_source_starts": {
      "items": {
        "type": "integer"
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Suggested Source Starts",
      "type": "array"
    },
    "merged_subframe_intervals": {
      "minimum": 0,
      "title": "Merged Subframe Intervals",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "pacing",
    "footage",
    "footage_frames",
    "requested_duration_seconds",
    "output_frames",
    "segments",
    "suggested_source_starts",
    "merged_subframe_intervals",
    "revision",
    "created_at",
    "generated_at",
    "updated_at"
  ],
  "title": "Plan",
  "type": "object"
}
